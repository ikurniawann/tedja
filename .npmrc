# pnpm's default symlinked node_modules breaks two things this repo relies on:
# Next.js standalone file tracing, and serverExternalPackages (tesseract.js
# spawns a worker from a real path inside node_modules; pdfkit reads its AFM
# fonts from disk at runtime). A hoisted layout is the flat, npm-shaped tree
# both of those already work against — pnpm still resolves/installs faster,
# only the final linking differs.
node-linker=hoisted

# Supply-chain guard: don't resolve a version published less than 7 days ago.
# This is npm's key (days). pnpm's own equivalent is minimumReleaseAge in
# pnpm-workspace.yaml and is measured in MINUTES — different key, different
# unit, so don't copy this number there. Largely belt-and-braces either way:
# CI installs with --frozen-lockfile and resolves nothing new, so this really
# guards the local `npm i` / `pnpm add` path.
min-release-age=7
